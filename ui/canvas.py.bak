from PySide6.QtCore import Qt, QPointF, Signal
from PySide6.QtGui import QPainter, QFont, QPen
from PySide6.QtWidgets import QWidget


class Canvas(QWidget):

    mouse_world_position = Signal(float, float)

    # فرمانی که از Ribbon انتخاب می‌شود
    commandFinished = Signal(str)

    def __init__(self, parent=None):
        super().__init__(parent)

        self.setMouseTracking(True)

        self.entities = []
        self.renderer = None

        self.background = Qt.GlobalColor.black

        # =================================================
        # Zoom / Pan
        # =================================================

        self.zoom = 1.0

        self.pan_x = 0.0
        self.pan_y = 0.0

        # =================================================
        # Mouse coordinates
        # =================================================

        self.mouse_x = 0.0
        self.mouse_y = 0.0

        # =================================================
        # Interactive command
        # =================================================

        self.active_command = ""

        self.command_points = []

        self.preview_point = None

        # =================================================
        # Pan
        # =================================================

        self._panning = False

        self._pan_start = QPointF()

        self._pan_origin_x = 0.0
        self._pan_origin_y = 0.0

    # =====================================================
    # RENDERER
    # =====================================================

    def set_renderer(self, renderer):

        self.renderer = renderer

        self.update()

    # =====================================================
    # ENTITIES
    # =====================================================

    def set_entities(self, entities):

        self.entities = entities

        self.update()

    # =====================================================
    # START COMMAND
    # =====================================================

    def start_command(self, command):

        self.active_command = str(
            command
        ).strip().upper()

        self.command_points = []

        self.preview_point = None

        self.setCursor(
            Qt.CursorShape.CrossCursor
        )

        self.update()

    # =====================================================
    # CANCEL COMMAND
    # =====================================================

    def cancel_command(self):

        self.active_command = ""

        self.command_points = []

        self.preview_point = None

        self.setCursor(
            Qt.CursorShape.ArrowCursor
        )

        self.update()

    # =====================================================
    # PAINT
    # =====================================================

    def paintEvent(self, event):

        painter = QPainter(self)

        painter.setRenderHint(
            QPainter.RenderHint.Antialiasing,
            True
        )

        painter.fillRect(
            self.rect(),
            self.background
        )

        # -------------------------------------------------
        # Renderer
        # -------------------------------------------------

        if self.renderer:

            self.renderer.render(
                painter,
                self,
                self.entities
            )

        # -------------------------------------------------
        # Preview
        # -------------------------------------------------

        self.draw_preview(
            painter
        )

        # -------------------------------------------------
        # Coordinates
        # -------------------------------------------------

        painter.save()

        painter.setPen(
            Qt.GlobalColor.white
        )

        font = QFont()

        font.setPointSize(10)
        font.setBold(True)

        painter.setFont(
            font
        )

        coordinate_text = (
            f"X = {self.mouse_x:.2f}    "
            f"Y = {self.mouse_y:.2f}"
        )

        painter.drawText(
            15,
            25,
            coordinate_text
        )

        # -------------------------------------------------
        # Active command
        # -------------------------------------------------

        if self.active_command:

            painter.drawText(
                15,
                48,
                f"Command: {self.active_command}"
            )

        painter.restore()

        painter.end()

    # =====================================================
    # PREVIEW
    # =====================================================

    def draw_preview(self, painter):

        if not self.active_command:

            return

        if self.preview_point is None:

            return

        pen = QPen(
            Qt.GlobalColor.yellow
        )

        pen.setWidth(2)

        pen.setStyle(
            Qt.PenStyle.DashLine
        )

        painter.setPen(
            pen
        )

        # =================================================
        # LINE
        # =================================================

        if self.active_command == "LINE":

            if len(self.command_points) == 1:

                p1 = self.world_to_screen(
                    self.command_points[0]
                )

                p2 = self.world_to_screen(
                    self.preview_point
                )

                painter.drawLine(
                    p1,
                    p2
                )

                return

        # =================================================
        # RECTANG
        # =================================================

        if self.active_command in (
            "RECTANG",
            "RECTANGLE"
        ):

            if len(self.command_points) == 1:

                p1 = self.world_to_screen(
                    self.command_points[0]
                )

                p2 = self.world_to_screen(
                    self.preview_point
                )

                left = min(
                    p1.x(),
                    p2.x()
                )

                right = max(
                    p1.x(),
                    p2.x()
                )

                top = min(
                    p1.y(),
                    p2.y()
                )

                bottom = max(
                    p1.y(),
                    p2.y()
                )

                painter.drawRect(
                    int(left),
                    int(top),
                    int(right - left),
                    int(bottom - top)
                )

                return

        # =================================================
        # CIRCLE
        # =================================================

        if self.active_command == "CIRCLE":

            if len(self.command_points) == 1:

                center = self.world_to_screen(
                    self.command_points[0]
                )

                current = self.world_to_screen(
                    self.preview_point
                )

                dx = (
                    current.x()
                    - center.x()
                )

                dy = (
                    current.y()
                    - center.y()
                )

                radius = (
                    dx * dx
                    + dy * dy
                ) ** 0.5

                painter.drawEllipse(
                    center,
                    radius,
                    radius
                )

                return

        # =================================================
        # POINT
        # =================================================

        if self.active_command == "POINT":

            point = self.world_to_screen(
                self.preview_point
            )

            size = 5

            painter.drawLine(
                int(point.x() - size),
                int(point.y()),
                int(point.x() + size),
                int(point.y())
            )

            painter.drawLine(
                int(point.x()),
                int(point.y() - size),
                int(point.x()),
                int(point.y() + size)
            )

    # =====================================================
    # SCREEN → WORLD
    # =====================================================

    def screen_to_world(self, point):

        cx = self.width() / 2.0
        cy = self.height() / 2.0

        x = (
            (point.x() - cx)
            / self.zoom
            - self.pan_x
        )

        y = (
            (cy - point.y())
            / self.zoom
            - self.pan_y
        )

        return QPointF(
            x,
            y
        )

    # =====================================================
    # WORLD → SCREEN
    # =====================================================

    def world_to_screen(self, point):

        cx = self.width() / 2.0
        cy = self.height() / 2.0

        x = (
            cx
            + (
                point.x()
                + self.pan_x
            )
            * self.zoom
        )

        y = (
            cy
            - (
                point.y()
                + self.pan_y
            )
            * self.zoom
        )

        return QPointF(
            x,
            y
        )

    # =====================================================
    # MOUSE MOVE
    # =====================================================

    def mouseMoveEvent(self, event):

        world = self.screen_to_world(
            event.position()
        )

        self.mouse_x = world.x()
        self.mouse_y = world.y()

        self.mouse_world_position.emit(
            self.mouse_x,
            self.mouse_y
        )

        # -------------------------------------------------
        # Pan
        # -------------------------------------------------

        if self._panning:

            delta = (
                event.position()
                - self._pan_start
            )

            self.pan_x = (
                self._pan_origin_x
                + delta.x()
                / self.zoom
            )

            self.pan_y = (
                self._pan_origin_y
                - delta.y()
                / self.zoom
            )

        # -------------------------------------------------
        # Preview
        # -------------------------------------------------

        if self.active_command:

            self.preview_point = QPointF(
                world
            )

        self.update()

        event.accept()

    # =====================================================
    # MOUSE PRESS
    # =====================================================

    def mousePressEvent(self, event):

        # =================================================
        # MIDDLE BUTTON = PAN
        # =================================================

        if event.button() == Qt.MouseButton.MiddleButton:

            self._panning = True

            self._pan_start = event.position()

            self._pan_origin_x = self.pan_x
            self._pan_origin_y = self.pan_y

            self.setCursor(
                Qt.CursorShape.ClosedHandCursor
            )

            event.accept()

            return

        # =================================================
        # LEFT BUTTON = DRAW
        # =================================================

        if event.button() == Qt.MouseButton.LeftButton:

            if self.active_command:

                world = self.screen_to_world(
                    event.position()
                )

                self.handle_command_click(
                    world
                )

                event.accept()

                return

        super().mousePressEvent(
            event
        )

    # =====================================================
    # COMMAND CLICK
    # =====================================================

    def handle_command_click(
        self,
        point
    ):

        command = self.active_command

        # =================================================
        # LINE
        # =================================================

        if command == "LINE":

            self.command_points.append(
                QPointF(point)
            )

            if len(self.command_points) == 2:

                p1 = self.command_points[0]
                p2 = self.command_points[1]

                self.entities.append(
                    {
                        "type": "LINE",
                        "p1": QPointF(p1),
                        "p2": QPointF(p2),
                    }
                )

                self.commandFinished.emit(
                    "LINE"
                )

                self.command_points = []

                self.preview_point = None

                self.update()

            return

        # =================================================
        # RECTANG
        # =================================================

        if command in (
            "RECTANG",
            "RECTANGLE"
        ):

            self.command_points.append(
                QPointF(point)
            )

            if len(self.command_points) == 2:

                p1 = self.command_points[0]
                p2 = self.command_points[1]

                self.entities.append(
                    {
                        "type": "RECTANG",
                        "p1": QPointF(p1),
                        "p2": QPointF(p2),
                    }
                )

                self.commandFinished.emit(
                    "RECTANG"
                )

                self.command_points = []

                self.preview_point = None

                self.update()

            return

        # =================================================
        # CIRCLE
        # =================================================

        if command == "CIRCLE":

            self.command_points.append(
                QPointF(point)
            )

            if len(self.command_points) == 2:

                center = self.command_points[0]

                current = self.command_points[1]

                dx = (
                    current.x()
                    - center.x()
                )

                dy = (
                    current.y()
                    - center.y()
                )

                radius = (
                    dx * dx
                    + dy * dy
                ) ** 0.5

                self.entities.append(
                    {
                        "type": "CIRCLE",
                        "center": QPointF(center),
                        "radius": radius,
                    }
                )

                self.commandFinished.emit(
                    "CIRCLE"
                )

                self.command_points = []

                self.preview_point = None

                self.update()

            return

        # =================================================
        # POINT
        # =================================================

        if command == "POINT":

            self.entities.append(
                {
                    "type": "POINT",
                    "point": QPointF(point),
                }
            )

            self.commandFinished.emit(
                "POINT"
            )

            self.preview_point = None

            self.update()

            return

    # =====================================================
    # MOUSE RELEASE
    # =====================================================

    def mouseReleaseEvent(self, event):

        if event.button() == Qt.MouseButton.MiddleButton:

            self._panning = False

            self.setCursor(
                Qt.CursorShape.ArrowCursor
            )

            event.accept()

            return

        super().mouseReleaseEvent(
            event
        )

    # =====================================================
    # WHEEL / ZOOM
    # =====================================================

    def wheelEvent(self, event):

        mouse_pos = event.position()

        old_world = self.screen_to_world(
            mouse_pos
        )

        delta = event.angleDelta().y()

        if delta > 0:

            factor = 1.2

        elif delta < 0:

            factor = 1.0 / 1.2

        else:

            return

        self.zoom *= factor

        self.zoom = max(
            0.05,
            min(
                self.zoom,
                100.0
            )
        )

        new_world = self.screen_to_world(
            mouse_pos
        )

        self.pan_x += (
            new_world.x()
            - old_world.x()
        )

        self.pan_y += (
            new_world.y()
            - old_world.y()
        )

        self.update()

        event.accept()

    # =====================================================
    # CLEAR
    # =====================================================

    def clear(self, color):

        self.background = color

        self.update()

    # =====================================================
    # UPDATE
    # =====================================================

    def update_canvas(self):

        self.update()

    # =====================================================
    # RESIZE
    # =====================================================

    def resizeEvent(self, event):

        super().resizeEvent(
            event
        )