from __future__ import annotations

from PySide6.QtWidgets import (
    QMainWindow,
    QWidget,
    QVBoxLayout,
)

from ui.canvas import Canvas
from ui.status_bar import StatusBar
from ui.ribbon import Ribbon
from ui.command_line import CommandLine

from drawing_commands import DrawingCommands


class MainWindow(QMainWindow):

    def __init__(self):

        super().__init__()

        self.setWindowTitle(
            "MCI SoftEngine"
        )

        self.resize(
            1600,
            900
        )

        # =================================================
        # Canvas
        # =================================================

        self.canvas = Canvas(
            self
        )

        # =================================================
        # Ribbon
        # =================================================

        self.ribbon = Ribbon(
            self
        )

        # =================================================
        # Command Line
        # =================================================

        self.command_line = CommandLine(
            self
        )

        # =================================================
        # Drawing Commands
        # =================================================

        self.commands = DrawingCommands(
            self.canvas
        )

        # =================================================
        # Build UI
        # =================================================

        self._build_ui()

        # =================================================
        # Connections
        # =================================================

        self.ribbon.commandRequested.connect(
            self.execute_command
        )

        self.command_line.commandEntered.connect(
            self.execute_command
        )

        self.canvas.mouse_world_position.connect(
            self.update_coordinates
        )

        # =================================================
        # Initial Coordinates
        # =================================================

        self.update_coordinates(
            0.0,
            0.0
        )

    # =====================================================
    # BUILD UI
    # =====================================================

    def _build_ui(self):

        central = QWidget(
            self
        )

        layout = QVBoxLayout(
            central
        )

        layout.setContentsMargins(
            0,
            0,
            0,
            0
        )

        layout.setSpacing(
            0
        )

        # -------------------------------------------------
        # Ribbon
        # -------------------------------------------------

        layout.addWidget(
            self.ribbon,
            0
        )

        # -------------------------------------------------
        # Canvas
        # -------------------------------------------------

        layout.addWidget(
            self.canvas,
            1
        )

        # -------------------------------------------------
        # Command Line
        # -------------------------------------------------

        layout.addWidget(
            self.command_line,
            0
        )

        self.setCentralWidget(
            central
        )

        # =================================================
        # Status Bar
        # =================================================

        self._status_bar = StatusBar(
            self
        )

        self.setStatusBar(
            self._status_bar
        )

    # =====================================================
    # COMMAND EXECUTION
    # =====================================================

    def execute_command(
        self,
        command
    ):

        command = str(
            command
        ).strip()

        if not command:
            return

        command_upper = command.upper()

        # =================================================
        # Interactive Drawing Commands
        # =================================================

        interactive_commands = (
            "LINE",
            "PLINE",
            "POLYLINE",
            "RECTANG",
            "RECTANGLE",
            "CIRCLE",
            "ARC",
            "POINT",
            "POLYGON",
            "ELLIPSE",
        )

        if command_upper in interactive_commands:

            self.canvas.start_command(
                command_upper
            )

            self.command_line.set_prompt(
                command_upper + ":"
            )

            self.command_line.clear()

            self.command_line.focus()

            return

        # =================================================
        # Text Commands
        # =================================================

        result = self.commands.execute(
            command
        )

        self.command_line.set_prompt(
            "Command:"
        )

        self.command_line.clear()

        self.command_line.focus()

        if result:

            self.statusBar().showMessage(
                result,
                5000
            )

    # =====================================================
    # COORDINATES
    # =====================================================

    def update_coordinates(
        self,
        x,
        y
    ):

        self._status_bar.set_coordinates(
            x,
            y
        )

    # =====================================================
    # RENDERER
    # =====================================================

    def set_renderer(
        self,
        renderer
    ):

        self.canvas.set_renderer(
            renderer
        )

    # =====================================================
    # ENTITIES
    # =====================================================

    def set_entities(
        self,
        entities
    ):

        self.canvas.set_entities(
            entities
        )