from PySide6.QtCore import QPointF
from PySide6.QtGui import QPen


class Renderer:

    def __init__(self):
        pass

    # =====================================================
    # WORLD → SCREEN
    # =====================================================

    def world_to_screen(self, canvas, point):

        cx = canvas.width() / 2.0
        cy = canvas.height() / 2.0

        if isinstance(point, QPointF):

            x = point.x()
            y = point.y()

        elif isinstance(point, (list, tuple)):

            x = point[0]
            y = point[1]

        else:

            try:
                x = point.x()
                y = point.y()

            except AttributeError:

                x = point[0]
                y = point[1]

        screen_x = (
            cx
            + (x + canvas.pan_x)
            * canvas.zoom
        )

        screen_y = (
            cy
            - (y + canvas.pan_y)
            * canvas.zoom
        )

        return QPointF(
            screen_x,
            screen_y
        )

    # =====================================================
    # RENDER
    # =====================================================

    def render(self, painter, canvas, entities):

        if not entities:
            return

        pen = QPen(
            QtColor.white
        )

        pen.setWidth(2)

        painter.setPen(pen)

        for entity in entities:

            if not isinstance(entity, dict):
                continue

            entity_type = str(
                entity.get("type", "")
            ).upper()

            # =============================================
            # LINE
            # =============================================

            if entity_type == "LINE":

                p1 = entity.get("p1")
                p2 = entity.get("p2")

                if p1 is None or p2 is None:
                    continue

                screen_p1 = self.world_to_screen(
                    canvas,
                    p1
                )

                screen_p2 = self.world_to_screen(
                    canvas,
                    p2
                )

                painter.drawLine(
                    screen_p1,
                    screen_p2
                )

                continue

            # =============================================
            # RECTANG
            # =============================================

            if entity_type in (
                "RECTANG",
                "RECTANGLE"
            ):

                p1 = entity.get("p1")
                p2 = entity.get("p2")

                if p1 is None or p2 is None:
                    continue

                screen_p1 = self.world_to_screen(
                    canvas,
                    p1
                )

                screen_p2 = self.world_to_screen(
                    canvas,
                    p2
                )

                left = min(
                    screen_p1.x(),
                    screen_p2.x()
                )

                right = max(
                    screen_p1.x(),
                    screen_p2.x()
                )

                top = min(
                    screen_p1.y(),
                    screen_p2.y()
                )

                bottom = max(
                    screen_p1.y(),
                    screen_p2.y()
                )

                painter.drawRect(
                    int(left),
                    int(top),
                    int(right - left),
                    int(bottom - top)
                )

                continue

            # =============================================
            # CIRCLE
            # =============================================

            if entity_type == "CIRCLE":

                center = entity.get("center")
                radius = entity.get("radius")

                if center is None or radius is None:
                    continue

                screen_center = self.world_to_screen(
                    canvas,
                    center
                )

                screen_radius = (
                    radius * canvas.zoom
                )

                painter.drawEllipse(
                    screen_center,
                    screen_radius,
                    screen_radius
                )

                continue

            # =============================================
            # POINT
            # =============================================

            if entity_type == "POINT":

                point = entity.get("point")

                if point is None:
                    continue

                screen_point = self.world_to_screen(
                    canvas,
                    point
                )

                size = 5

                painter.drawLine(
                    int(screen_point.x() - size),
                    int(screen_point.y()),
                    int(screen_point.x() + size),
                    int(screen_point.y())
                )

                painter.drawLine(
                    int(screen_point.x()),
                    int(screen_point.y() - size),
                    int(screen_point.x()),
                    int(screen_point.y() + size)
                )

                continue


# =========================================================
# Qt Color
# =========================================================

from PySide6.QtCore import Qt

QtColor = Qt.GlobalColor